    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.489",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^4.0.3",
    "jsdom": "^29.1.1",
