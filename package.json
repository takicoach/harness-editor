{
  "name": "harness-editor",
  "private": true,
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "edit": "vite",
    "dev": "vite",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "playwright test --config playwright.isolated.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.legacy-fixtures.json",
    "learn": "node --import tsx src/learning/bin.ts",
    "aggregate-cuts": "node --import tsx src/server/aggregateCutLearningBin.ts",
    "docs:shots": "node scripts/capture-guide-shots.mjs",
    "docs:help-shots": "node scripts/capture-help-shots.mjs",
    "desktop:dev": "HARNESS_DESKTOP_NODE=$(command -v node) npm --prefix desktop start",
    "desktop:mac": "npm --prefix desktop run package:mac",
    "test:desktop": "npm --prefix desktop test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.0",
    "mammoth": "1.12.3",
    "mp4box": "2.4.1",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "5.6.205",
    "playwright-core": "1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^4.0.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
